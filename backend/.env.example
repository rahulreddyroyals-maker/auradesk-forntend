ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:password@db.your-project.supabase.co:5432/postgres
# Optional, recommended before real client data: connect as a restricted,
# non-owner role instead (see sql/restrict_app_role.sql) so RLS actually
# applies. Falls back to DATABASE_URL if unset.
DATABASE_URL_ADMIN=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Keep false for local dev over ngrok; set true in production (see
# app/api/v1/sms.py for what correct signature validation requires
# behind your specific proxy/deployment).
TWILIO_VALIDATE_SIGNATURE=false

GROQ_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENTRY_DSN=
POSTHOG_API_KEY=

FRONTEND_ORIGINS=["http://localhost:3001"]
